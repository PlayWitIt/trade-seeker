{
	"schemaVersion": 1,
	"id": "tradeseeker",
	"version": "${version}",
	"name": "Trade Seeker",
	"description": "Re-rolls a librarian for you: breaks and replaces its lectern until it offers the enchanted book you picked, at a price you accept. Client-side only.",
	"authors": [
		"PlayWit Creations"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/trade-seeker",
		"sources": "https://github.com/PlayWitIt/trade-seeker",
		"issues": "https://github.com/PlayWitIt/trade-seeker/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.greysworkshop.tradeseeker.TradeSeekerClient"
		],
		"modmenu": [
			"com.greysworkshop.tradeseeker.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"mixins": [
		"tradeseeker.mixins.json"
	],
	"icon": "assets/tradeseeker/icon.png"
}
